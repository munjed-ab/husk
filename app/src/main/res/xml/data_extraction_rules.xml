<?xml version="1.0" encoding="utf-8"?><!--
   Android 12+. Recordings are excluded from both cloud backup and device-to-device transfer, so a
   recording exists on exactly one phone and nowhere else.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="recordings/" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="recordings/" />
    </device-transfer>
</data-extraction-rules>
