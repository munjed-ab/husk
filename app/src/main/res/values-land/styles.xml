<resources>

    <!-- Landscape overrides for the single fragment_home.xml, see values/styles.xml -->
    <style name="HomeDateTimeLayout">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:layout_marginHorizontal">0dp</item>
        <item name="android:layout_marginTop">48dp</item>
    </style>

    <style name="HomeScreenTime" parent="TextSmall">
        <item name="android:layout_marginHorizontal">74dp</item>
    </style>

    <style name="HomeAppsLayout">
        <item name="android:layout_marginHorizontal">74dp</item>
        <item name="android:paddingHorizontal">0dp</item>
        <!-- only the media row still overlays, so that is all the padding has to clear -->
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">76dp</item>
    </style>

    <style name="HomeTips" parent="TextSmall">
        <item name="android:layout_gravity">bottom|center_horizontal</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
    </style>

    <style name="HomeSetDefault" parent="TextMedium">
        <item name="android:layout_marginHorizontal">24dp</item>
    </style>

</resources>
