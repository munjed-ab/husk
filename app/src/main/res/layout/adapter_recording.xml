<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rowLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingVertical="@dimen/app_padding_vertical">

    <TextView
        android:id="@+id/rowTitle"
        style="@style/TextLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1" />

    <TextView
        android:id="@+id/rowDetail"
        style="@style/TextSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1" />

    <!-- Long press: the same inline menu the app drawer uses, instead of a system popup -->
    <LinearLayout
        android:id="@+id/menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="?attr/primaryShadeDarkColor"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/menuShare"
            style="@style/TextSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:maxLines="1"
            android:paddingVertical="8dp"
            android:text="@string/share"
            android:textSize="12sp"
            app:drawableTopCompat="@drawable/ic_share" />

        <TextView
            android:id="@+id/menuDelete"
            style="@style/TextSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:maxLines="1"
            android:paddingVertical="8dp"
            android:text="@string/delete_recording"
            android:textSize="12sp"
            app:drawableTopCompat="@drawable/ic_delete" />

        <TextView
            android:id="@+id/menuClose"
            style="@style/TextSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:maxLines="1"
            android:paddingVertical="8dp"
            android:text="@string/close"
            android:textSize="12sp"
            app:drawableTopCompat="@drawable/ic_close" />
    </LinearLayout>

    <!-- Only on the row that is playing: drag to scrub, or step 10 s either way -->
    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <SeekBar
            android:id="@+id/seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="0dp"
            android:paddingVertical="12dp"
            android:progressBackgroundTint="?attr/primaryColorTrans50"
            android:progressTint="?attr/primaryColor"
            android:thumbTint="?attr/primaryColor" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/time"
                style="@style/TextSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/back"
                    style="@style/TextSmallBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="12dp"
                    android:text="@string/seek_back" />

                <ImageView
                    android:id="@+id/pause"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/media_play"
                    android:padding="8dp"
                    android:src="@drawable/ic_media_pause" />

                <TextView
                    android:id="@+id/forward"
                    style="@style/TextSmallBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="12dp"
                    android:text="@string/seek_forward" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
